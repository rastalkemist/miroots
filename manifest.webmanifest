{
  "id": "/",
  "name": "Mi Roots - l’app pour NU",
  "short_name": "Mi Roots",
  "description": "L’app pour NU et les habitués du Roots. Commande à la carte, réserve ta place ou ton séjour, retrouve ta réservation par son code — sans compte. Trois univers : Roots au centre, Roam pour découvrir le Bénin, Space pour ton quotidien au Roots.",
  "lang": "fr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "theme_color": "#005B22",
  "background_color": "#FDFBF6",
  "icons": [
    {
      "src": "icones/icone-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icones/icone-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icones/icone-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icones/icone-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://mi.roots.bj/manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false,
  "share_target": {
    "action": "./notes.html",
    "method": "GET",
    "params": {
      "title": "titre",
      "text": "texte",
      "url": "adresse"
    }
  }
}
