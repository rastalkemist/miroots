#!/bin/sh
# ─────────────────────────────────────────────────────────────
# pre-push — dernière barrière avant l'irréversible
#
# Le pre-commit peut être contourné (--no-verify) ou avoir été
# absent au moment d'un commit. Ce hook rescanne TOUT ce qui est
# sur le point de partir, y compris les commits anciens.
#
# Frontière franchie ici = « public pour toujours ».
# ─────────────────────────────────────────────────────────────
set -u

# ── Normalisation Unicode ─────────────────────────────────────────────
# Un accent peut s'ecrire d'une seule piece, ou comme la lettre suivie
# d'un signe. Les deux se ressemblent a l'ecran et ne se ressemblent pas
# a la comparaison : sans cette etape, la seconde forme traverse tous les
# motifs. On ramene le texte a une forme unique avant de comparer.
# Sans normaliseur disponible, on continue et on le DIT : un filet dont
# on ignore la portee est pire qu'un filet troue.
normaliser_nfc() {
  if perl -CSD -MUnicode::Normalize -e1 >/dev/null 2>&1; then
    perl -CSD -MUnicode::Normalize -pe '$_ = NFC($_)'
  else
    printf '%s\n' "  ! normaliseur Unicode absent : la forme decomposee d'un accent n'est pas couverte" >&2
    cat
  fi
}


# Fichier de règles, dans un dossier VOISIN du dépôt et jamais versionné.
# Adapter ce chemin si le dossier porte un autre nom.
DENYLIST="${ROOTS_REGLES:-../roots-interne/denylist.txt}"
FAIL=0
ZERO="0000000000000000000000000000000000000000"

rouge() { printf '\033[1;31m%s\033[0m\n' "$1"; }
jaune() { printf '\033[1;33m%s\033[0m\n' "$1"; }
vert()  { printf '\033[1;32m%s\033[0m\n' "$1"; }

if [ ! -f "$DENYLIST" ]; then
  rouge "═══ PUSH BLOQUÉ ═══"
  echo "Denylist introuvable : $DENYLIST — refus de pousser à l aveugle."
  exit 1
fi

# stdin : <ref_locale> <sha_local> <ref_distante> <sha_distant>
while read -r ref_locale sha_local ref_distante sha_distant; do
  [ "$sha_local" = "$ZERO" ] && continue          # suppression de branche

  EXCL=". :(exclude).githooks/* :(exclude).gitignore"

  if [ "$sha_distant" = "$ZERO" ]; then
    RACINE=$(git rev-list --max-parents=0 "$sha_local" | tail -1)
    PLAGE="$RACINE..$sha_local"                   # branche neuve
  else
    PLAGE="$sha_distant..$sha_local"
  fi
  DIFF=$(git diff -U0 "$PLAGE" -- $EXCL 2>/dev/null)

  [ -z "$DIFF" ] && continue

  # Chemins internes présents dans les commits à pousser
  FICHIERS=$(git diff --name-only "$PLAGE" 2>/dev/null | grep -E '^_internal/' || true)
  if [ -n "$FICHIERS" ]; then
    rouge "═══ PUSH BLOQUÉ ═══"
    echo "Des fichiers internes sont présents dans l'historique à pousser :"
    printf '%s\n' "$FICHIERS" | sed 's/^/  → /'
    echo ""
    echo "Ne pas se contenter de les retirer : réécrire l'historique"
    echo "(git filter-repo) AVANT de pousser quoi que ce soit."
    FAIL=1
  fi

  AJOUTS=$(printf '%s\n' "$DIFF" | grep -E '^\+' | grep -vE '^\+\+\+' | normaliser_nfc || true)
  [ -z "$AJOUTS" ] && continue

  AJOUTS_PROSE=$(printf '%s\n' "$AJOUTS" \
    | grep -vE 'https?://' \
    | grep -vE '^\+[[:space:]]*(const|let|var|export|import)[[:space:]]' \
    | grep -vE '(_URL|_KEY|_ENDPOINT|_HOST)[[:space:]]*[:=]' || true)

  while IFS= read -r motif || [ -n "$motif" ]; do
    case "$motif" in ''|\#*) continue ;; esac

    CIBLE="$AJOUTS"
    case "$motif" in
      @runtime-ok:*) motif=${motif#@runtime-ok:}; CIBLE="$AJOUTS_PROSE" ;;
    esac

    HITS=$(printf '%s\n' "$CIBLE" | grep -iE -- "$motif" || true)
    if [ -n "$HITS" ]; then
      if [ "$FAIL" -eq 0 ]; then rouge "═══ PUSH BLOQUÉ ═══"; fi
      echo ""
      jaune "Motif interdit dans $PLAGE : $motif"
      printf '%s\n' "$HITS" | head -5 | sed 's/^/  → /'
      FAIL=1
    fi
  done < "$DENYLIST"
done

if [ "$FAIL" -ne 0 ]; then
  echo ""
  rouge "Rien n'est poussé. Poussé = public pour toujours."
  echo "Si un secret est concerné : le FAIRE TOURNER, pas seulement le retirer."
  exit 1
fi

vert "✓ Pre-push : rien à signaler."
exit 0
